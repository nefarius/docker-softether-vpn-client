#!/bin/sh
set -eu

NET_SYS="${SE_SYS_NET:-/sys/class/net}"
WAIT_ATTEMPTS="${SE_DHCP_WAIT_ATTEMPTS:-60}"
WAIT_INTERVAL="${SE_DHCP_WAIT_INTERVAL:-1}"

if [ -z "${SE_NICNAME:-}" ]; then
    echo "Please provide SE_NICNAME environment variable" >&2
    exit 1
fi

iface="vpn_${SE_NICNAME}"
attempt=0
while [ ! -d "${NET_SYS}/${iface}" ]; do
    attempt=$((attempt + 1))
    if [ "$attempt" -ge "$WAIT_ATTEMPTS" ]; then
        echo "Timed out waiting for ${iface}" >&2
        exit 1
    fi
    sleep "$WAIT_INTERVAL"
done

if [ -z "${SE_MAC_LINUX:-}" ] && [ -n "${SE_MAC_ADDRESS:-}" ]; then
    SE_MAC_LINUX=$(printf '%s' "$SE_MAC_ADDRESS" | tr '[:upper:]' '[:lower:]' | tr '-' ':')
fi

# NicSetSetting is applied before the client starts. If the adapter still
# comes up with a different address, set it here before dhcpcd builds the
# client identifier from the hardware address.
if [ -n "${SE_MAC_LINUX:-}" ]; then
    current=$(cat "${NET_SYS}/${iface}/address")
    if [ "$current" != "$SE_MAC_LINUX" ]; then
        ip link set dev "$iface" down
        ip link set dev "$iface" address "$SE_MAC_LINUX"
        ip link set dev "$iface" up
    fi
fi

if [ -n "${SE_MAC_LINUX:-}" ]; then
    dhcpcd_conf="${SE_DHCPCD_CONF:-/etc/dhcpcd-vpn.conf}"
else
    dhcpcd_conf="${SE_DHCPCD_DUID_CONF:-/etc/dhcpcd-vpn-duid.conf}"
fi

# --nohook resolv.conf keeps VPN DHCP from replacing the container resolv.conf.
# --nobackground keeps dhcpcd attached to Supervisor.
# The TAP reports itself as Ethernet. dhcpcd then leaves the BOOTP broadcast
# flag clear, and the server unicasts the offer to an address the adapter does
# not have yet. Windows and the previous dhclient setup request a broadcast
# offer, which a SoftEther TAP can receive. --noipv4ll stops the 169.254
# fallback from hiding a missed lease.
set -- \
    --nobackground \
    --debug \
    --nohook \
    resolv.conf \
    --broadcast \
    --noipv4ll \
    -f \
    "$dhcpcd_conf"

if [ -n "${SE_DHCP_HOSTNAME:-}" ]; then
    # dhcpcd treats a separate argument after --hostname as an interface name.
    set -- "$@" "--hostname=${SE_DHCP_HOSTNAME}"
fi

set -- "$@" "$iface"
exec dhcpcd "$@"
